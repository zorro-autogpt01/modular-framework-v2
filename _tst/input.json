        }
      ]
    },
    {
      "op": "patch_text",
      "id": "actioncard_modal_selection",
      "description": "Show modal when action template requires selected_text and no selection chosen",
      "path": "src/components/actions/ActionCard.tsx",
      "patches": [
        {
          "type": "insert_after",
          "anchor": "import { api } from '@services/api';",
          "replacement": "\nimport Modal from '@components/shared/Modal';\nimport { useState } from 'react';\n"
        },
        {
          "type": "insert_after",
          "anchor": "export default function ActionCard({ action }: { action: any }) {",
          "replacement": "\n  const [confirmOpen, setConfirmOpen] = useState(false);\n"
        },
        {
          "type": "replace_between",
          "start": "  const onUse = async () => {",
          "end": "  };",
          "include_anchors": true,
          "replacement": "  const onUse = async () => {\n    await api.trackActionUse(action.id);\n    const template: string = action.prompt_template;\n    const needsSelection = template.includes('{{selected_text}}');\n    let prompt = template;\n    if (needsSelection) {\n      setConfirmOpen(true);\n      return;\n    }\n    const el = document.getElementById('message-input') as HTMLTextAreaElement | null;\n    if (el) { el.value = prompt; el.focus(); }\n    s.setActiveTab('tree');\n  };"
        },
        {
          "type": "insert_after",
          "anchor": "<div className=\"mt-3\"><Button variant=\"primary\" className=\"w-full h-9\" onClick={onUse}>Use Action</Button></div>",
          "replacement": "\n      <Modal open={confirmOpen} onClose={() => setConfirmOpen(false)} title=\"Select text first or use last message?\">\n        <div className=\"text-sm text-slate-300\">No selection detected. Use the last message as input?</div>\n        <div className=\"flex justify-end gap-2 mt-4\">\n          <Button variant=\"ghost\" onClick={() => setConfirmOpen(false)}>Cancel</Button>\n          <Button variant=\"primary\" onClick={() => {\n            const lastMsg = s.messages.slice().reverse().find(m => m.role==='assistant' || m.role==='user');\n            if (!lastMsg) return setConfirmOpen(false);\n            const filled = action.prompt_template.replace('{{selected_text}}', lastMsg.content).replace('{{conversation_context}}', s.messages.map(m=>`${m.role}: ${m.content}`).join('\\n'));\n            const el = document.getElementById('message-input') as HTMLTextAreaElement | null;\n            if (el) { el.value = filled; el.focus(); }\n            s.setActiveTab('tree');\n            setConfirmOpen(false);\n          }}>Use Last Message</Button>\n        </div>\n      </Modal>"
        }
      ]
    },
    {
      "op": "patch_text",
      "id": "priority_unpin_all",
      "description": "Implement Unpin All action in Message Priority panel",
      "path": "src/components/context/MessagePriority.tsx",
