{
  "repo_root": "/home/tux/project/modular-framework/modules/github-hub",
  "ignore_globs_effective": [
    "**/.git/**",
    "**/.hg/**",
    "**/.svn/**",
    "**/.venv/**",
    "**/venv/**",
    "**/env/**",
    "**/__pycache__/**",
    "**/site-packages/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "**/.tox/**",
    "**/.idea/**",
    "**/.vscode/**"
  ],
  "languages": [
    "py",
    "js"
  ],
  "counts": {
    "py": 11,
    "js": 3,
    "java": 0,
    "go": 0,
    "rb": 0,
    "php": 0,
    "cs": 0
  },
  "services": [
    {
      "name": "default",
      "root": ".",
      "entrypoints": [
        "app/main.py"
      ],
      "frameworks": [
        "fastapi"
      ],
      "http_base_prefixes": [
        "/api",
        "/.well-known"
      ],
      "routes_index_hint": {
        "": [
          "app/main.py:root"
        ],
        "/.well-known/module.json": [
          "app/main.py:module_manifest_root"
        ],
        "/api/.well-known/module.json": [
          "app/main.py:module_manifest_api"
        ],
        "/api/health": [
          "app/main.py:health"
        ],
        "/api/poll/run": [
          "app/main.py:trigger_global_poll"
        ],
        "/api/connections/{conn_id}/poll/run": [
          "app/main.py:trigger_connection_poll"
        ],
        "/api/poll/status": [
          "app/main.py:get_poll_status"
        ],
        "/api/subscriptions": [
          "app/main.py:create_subscription",
          "app/main.py:get_subscriptions"
        ],
        "/api/subscriptions/{sub_id}": [
          "app/main.py:delete_subscription_endpoint",
          "app/main.py:get_subscription_by_id",
          "app/main.py:update_subscription"
        ],
        "/api/subscriptions/{sub_id}/test": [
          "app/main.py:test_subscription"
        ],
        "/api/subscriptions/{sub_id}/pause": [
          "app/main.py:pause_subscription"
        ],
        "/api/subscriptions/{sub_id}/resume": [
          "app/main.py:resume_subscription"
        ],
        "/api/connections": [
          "app/main.py:api_list_conns",
          "app/main.py:api_upsert_conn"
        ],
        "/api/connections/validate": [
          "app/main.py:api_validate_conn"
        ],
        "/api/connections/{conn_id}": [
          "app/main.py:api_delete_conn",
          "app/main.py:api_get_connection"
        ],
        "/api/connections/{conn_id}/default": [
          "app/main.py:api_set_default",
          "app/main.py:api_set_default_put"
        ],
        "/api/connections/{conn_id}/health": [
          "app/main.py:api_conn_health"
        ],
        "/api/config": [
          "app/main.py:get_cfg",
          "app/main.py:legacy_set_cfg"
        ],
        "/api/branches": [
          "app/main.py:branches"
        ],
        "/api/branch": [
          "app/main.py:create_branch"
        ],
        "/api/tree": [
          "app/main.py:tree"
        ],
        "/api/file": [
          "app/main.py:delete_file",
          "app/main.py:get_file",
          "app/main.py:put_file"
        ],
        "/api/batch/commit": [
          "app/main.py:batch_commit"
        ],
        "/api/pr": [
          "app/main.py:create_pr"
        ],
        "/api/compare": [
          "app/main.py:compare"
        ],
        "/api/commits": [
          "app/main.py:list_commits"
        ],
        "/api/connections/{conn_id}/clone_url": [
          "app/main.py:api_get_clone_url"
        ],
        "/api/analyze/{owner}/{repo}": [
          "app/main.py:analyze_repository"
        ],
        "/api/cache/{owner}/{repo}": [
          "app/main.py:get_cached_analysis"
        ],
        "/api/map-openapi/{owner}/{repo}": [
          "app/main.py:map_openapi_endpoints"
        ],
        "/api/endpoint/{owner}/{repo}/{method}/{path:path}": [
          "app/main.py:get_single_endpoint"
        ],
        "/api/export-endpoint-context": [
          "app/main.py:export_endpoint_context"
        ]
      },
      "artifacts": {
        "openapi": [],
        "graphql": [],
        "grpc_protos": []
      },
      "python": {
        "fastapi_apps": [
          "app/main.py"
        ],
        "import_aliases": {
          "os": "os",
          "json": "json",
          "base64": "base64",
          "uuid": "uuid",
          "requests": "requests",
          "argparse": "argparse",
          "ast": "ast",
          "re": "re",
          "sys": "sys",
          "shutil": "shutil",
          "fnmatch": "fnmatch",
          "difflib": "difflib",
          "logging": "logging",
          "yaml": "yaml",
          "asyncio": "asyncio",
          "hmac": "hmac",
          "hashlib": "hashlib",
          "random": "random",
          "httpx": "httpx",
          "traceback": "traceback"
        }
      }
    }
  ]
}