digraph Slice {
  rankdir=LR;
  node [shape=box, fontname="Helvetica"];
  "app.store.load_all" -> "app.store._empty_store";
  "app.store.load_all" -> "app.store.save_all";
  "app.store.load_all" -> "app.store._ensure_dir";
  "app.store.save_all" -> "app.store._ensure_dir";
  "app.store.get_connection" -> "app.store.load_all";
  "app.store.get_connection" -> "app.store._dec";
  "app.store.upsert_connection" -> "app.store.save_all";
  "app.store.upsert_connection" -> "app.store.load_all";
  "app.store.upsert_connection" -> "app.store._enc";
  "app.store.upsert_connection" -> "app.store._dec";
  "app.store.list_subscriptions" -> "app.store.load_all";
